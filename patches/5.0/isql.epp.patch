+namespace Hq {
+namespace Isql {
+
+Firebird::ITransaction* userTransaction()
+{
+	return M_Transaction() ? M__trans : NULL;
+}
+
+bool commitUserTransaction()
+{
+	return !M__trans || commit_trans(&M__trans);
+}
+
+Firebird::PathName inputFileName()
+{
+	return Filelist->Ifp().fileName(false);
+}
+
+bool interactive()
+{
+	return Interactive && !Input_file;
+}
+
+bool interrupted()
+{
+	return Interrupt_flag || Abort_flag;
+}
+
+bool quiet()
+{
+	return Quiet;
+}
+
+void printErrorLocation()
+{
+	if (Input_file)
+	{
+		TEXT errbuf[MSG_LENGTH];
+		const InputDevices::indev& Ifp = Filelist->Ifp();
+		IUTILS_msg_get(AFTERLINE, errbuf, SafeArg() << Ifp.indev_line << Ifp.fileName(true).c_str());
+		STDERROUT(errbuf);
+	}
+}
