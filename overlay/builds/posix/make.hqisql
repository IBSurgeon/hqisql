#
# hqisql: isql with the replxx line editor (src/hqisql, extern/replxx).
#
# The variables and rules of hqisql. Two makefiles include this file:
#
#  - Makefile.in (the main build), after the definitions of the utilities:
#    "make" builds hqisql with isql (target utilities), "make tests" and
#    "make run_tests" build and run hqisql_test with the other tests;
#  - Makefile.hqisql, to build hqisql apart from the main build.
#
# The result is gen/<TARGET>/firebird/bin/hqisql and, next to the other
# license files, gen/<TARGET>/firebird/replxx-LICENSE.md. The objects go to
# temp/<TARGET>/hqisql; the standard isql and its objects do not change:
# only isql.cpp (generated by the main build from isql.epp) is compiled
# again, with -DHQISQL, the other isql objects are taken as they are.
#
# This file defines no default goal and includes no other files: the
# including makefile does both.
#

HQISQL		= $(BIN)/hqisql$(EXEC_EXT)
HQ_OBJ		= $(OBJ)/hqisql
REPLXX_ROOT	= $(ROOT)/extern/replxx

HQ_FLAGS	= -DHQISQL -DREPLXX_STATIC -I$(REPLXX_ROOT)/include

# replxx is third-party code: its own flags, not the Firebird warnings and
# -fno-rtti.
REPLXX_FLAGS	= -std=c++17 -O2 -fPIC $(THR_FLAGS) -DREPLXX_STATIC \
				  -I$(REPLXX_ROOT)/include -I$(REPLXX_ROOT)/src

HQ_Sources	= $(notdir $(wildcard $(SRC_ROOT)/hqisql/*.cpp))
REPLXX_Sources	= $(notdir $(wildcard $(REPLXX_ROOT)/src/*.cxx) $(wildcard $(REPLXX_ROOT)/src/*.cpp))

HQISQL_Objects	= $(HQ_OBJ)/isql.o \
				  $(addprefix $(HQ_OBJ)/,$(HQ_Sources:.cpp=.o)) \
				  $(addprefix $(HQ_OBJ)/replxx/,$(addsuffix .o,$(basename $(REPLXX_Sources)))) \
				  $(filter-out $(OBJ)/isql/isql.o,$(ISQL_Objects))

# The unit tests: the test sources and the modules they test - the ones
# without isql or replxx dependencies, as in hqisql_test.vcxproj - with
# gds.cpp and common.a like common_test.
HQISQL_TEST		= $(FB_TESTS_DIR)/hqisql_test$(EXEC_EXT)
HQ_Test_Sources	= $(notdir $(wildcard $(SRC_ROOT)/hqisql/tests/*.cpp))
HQ_Tested		= HqAvro HqCodec HqColors HqCopy HqCsv HqImportCommand HqIsqlCommands HqKeywords HqLexer HqParams HqParquet HqRows HqTable
HQ_Test_Objects	= $(addprefix $(HQ_OBJ)/tests/,$(HQ_Test_Sources:.cpp=.o)) \
				  $(addprefix $(HQ_OBJ)/,$(addsuffix .o,$(HQ_Tested))) \
				  $(call makeObjects,yvalve,gds.cpp)

.PHONY: hqisql hqisql_test run_hqisql_test clean_hqisql

hqisql:		$(HQISQL) $(FB_BUILD)/replxx-LICENSE.md

hqisql_test:	$(HQISQL_TEST)

run_hqisql_test:	$(HQISQL_TEST)
	$(HQISQL_TEST) --log_level=test_suite

$(HQISQL_TEST):	$(HQ_Test_Objects) $(COMMON_LIB)
	@mkdir -p $(@D)
	$(EXE_LINK) $(EXE_LINK_OPTIONS) $^ -o $@ -L$(LIB) -L$(STATIC_LIB) $(LINK_LIBS)

$(HQ_OBJ)/tests/%.o:	$(SRC_ROOT)/hqisql/tests/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(WCXXFLAGS) $(HQ_FLAGS) -c $< -o $@

# The replxx license goes into the kit with hqisql.
$(FB_BUILD)/replxx-LICENSE.md:	$(REPLXX_ROOT)/LICENSE.md
	cp $< $@

$(HQISQL):	$(HQISQL_Objects) $(COMMON_LIB)
	$(EXE_LINK) $(EXE_LINK_OPTIONS) $^ -o $@ $(FIREBIRD_LIBRARY_LINK) $(LIBEDITLINE) $(TERMLIB) $(THR_LIBS) $(LINK_LIBS)

$(HQ_OBJ)/isql.o:	$(OBJ)/isql/isql.cpp
	@mkdir -p $(@D)
	$(CXX) $(WCXXFLAGS) $(HQ_FLAGS) -c $< -o $@

$(HQ_OBJ)/%.o:	$(SRC_ROOT)/hqisql/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(WCXXFLAGS) $(HQ_FLAGS) -c $< -o $@

$(HQ_OBJ)/replxx/%.o:	$(REPLXX_ROOT)/src/%.cxx
	@mkdir -p $(@D)
	$(CXX) $(REPLXX_FLAGS) -c $< -o $@

$(HQ_OBJ)/replxx/%.o:	$(REPLXX_ROOT)/src/%.cpp
	@mkdir -p $(@D)
	$(CXX) $(REPLXX_FLAGS) -c $< -o $@

clean_hqisql:
	-$(RM) -r $(HQ_OBJ)
	-$(RM) $(HQISQL) $(HQISQL_TEST) $(FB_BUILD)/replxx-LICENSE.md

-include $(wildcard $(HQ_OBJ)/*.d)
