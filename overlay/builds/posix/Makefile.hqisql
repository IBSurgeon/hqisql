#
# hqisql: isql with the replxx line editor (src/hqisql, extern/replxx).
#
# Builds hqisql apart from the main build. Normally not needed: when
# Makefile.in includes make.hqisql, "make" builds hqisql with isql and
# "make run_tests" runs its unit tests. Without that include (hqisql
# installed with --no-hook), run it after the regular build, from the gen
# directory of the configured tree:
#
#   make -C gen -f ../builds/posix/Makefile.hqisql [TARGET=Release|Debug]
#
# The unit tests (the Boost.Test executable of hqisql_test.vcxproj):
#
#   make -C gen -f ../builds/posix/Makefile.hqisql hqisql_test
#   gen/<TARGET>/firebird/tests/hqisql_test --log_level=test_suite
#
# The variables and rules are in make.hqisql.
#

ROOT=$(shell cd ..; pwd)

ifeq ($(IsDeveloper), Y)
  TARGET ?= Debug
else
  TARGET ?= Release
endif

include     make.defaults
include     make.platform
include     make.rules
include     make.shared.variables

.DEFAULT_GOAL := hqisql

include     $(ROOT)/builds/posix/make.hqisql
